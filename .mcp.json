{
  "mcpServers": {
    "ingredient-game": {
      "command": "node",
      "args": ["mcp-server/dist/index.js"],
      "env": {
        "BACKEND_URL": "http://localhost:3002"
      }
    },
    "discord": {
      "command": "npx",
      "args": ["-y", "mcp-discord"],
      "env": {
        "DISCORD_TOKEN": "${DISCORD_TOKEN}"
      }
    }
  }
}
