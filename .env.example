# Backend
PORT=3002
NODE_ENV=development

# APM
DEFAULT_DIFFICULTY=easy
MAX_LEADERBOARD_SIZE=10
HINT_PENALTY_POINTS=10

# MCP Server
MCP_SERVER_PATH=./mcp-server/src/index.ts

# Discord Integration
# Webhook URL for automatic game notifications (scores, high scores, perfect rounds)
# Create one at: Discord Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Bot token for Claude Code discord-agent MCP access (optional — only needed for MCP)
# Create a bot at: https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token
